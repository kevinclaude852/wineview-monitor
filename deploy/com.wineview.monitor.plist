<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd job: run the monitor once an hour on macOS.

  Install, from the repo root:

      cp deploy/com.wineview.monitor.plist ~/Library/LaunchAgents/
      PLIST=~/Library/LaunchAgents/com.wineview.monitor.plist
      sed -i '' "s|__REPO_DIR__|$PWD|g" "$PLIST"

  Then open "$PLIST" and fill in the two REPLACE_WITH_ values below (by hand,
  so the bot token stays out of your shell history), and load it:

      launchctl bootstrap gui/$(id -u) "$PLIST"

  launchd caches the job when it is bootstrapped, so after any later edit to
  this file you must reload it. Running kickstart alone keeps the old copy:

      launchctl bootout gui/$(id -u)/com.wineview.monitor
      launchctl bootstrap gui/$(id -u) "$PLIST"
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.wineview.monitor</string>

    <key>ProgramArguments</key>
    <array>
        <string>__REPO_DIR__/.venv/bin/python</string>
        <string>main.py</string>
        <string>--once</string>
    </array>

    <!-- state.json and monitor.log are written relative to this directory -->
    <key>WorkingDirectory</key>
    <string>__REPO_DIR__</string>

    <!-- launchd does not inherit your shell environment -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>TELEGRAM_BOT_TOKEN</key>
        <string>REPLACE_WITH_BOT_TOKEN</string>
        <key>TELEGRAM_CHAT_ID</key>
        <string>REPLACE_WITH_CHAT_ID</string>
    </dict>

    <!-- Every hour, on the hour. If the Mac is asleep at that moment,
         launchd runs the job once after it wakes. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>__REPO_DIR__/monitor.log</string>
    <key>StandardErrorPath</key>
    <string>__REPO_DIR__/monitor.log</string>
</dict>
</plist>
